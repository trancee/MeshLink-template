# yamllint configuration — see https://yamllint.readthedocs.io
#
# MeshLink keeps its orchestration cockpit under specs/ as tracked YAML
# artifacts. They intentionally omit the `---` document-start marker and use
# long inline strings (up to 248 chars). Since yamllint overrides do not
# apply in file mode, spec files are linted separately in CI and git hooks
# with a relaxed inline config (line-length disabled) so structural errors
# (the frames.yaml class of bugs) are still caught. Source/gradle YAML is
# fully linted by the standard `yamllint .` run.
ignore: |
  specs/
  .git
  .gradle/
  build/
  gradle/

rules:
  document-start: disable
  line-length:
    max: 120
    level: error
    allow-non-breakable-words: true
    allow-non-breakable-inline-mappings: true
  comments:
    min-spaces-from-content: 1
  truthy:
    check-keys: false
