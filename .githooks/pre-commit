#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

staged_files=()
pre_format_hashes=()

while IFS= read -r -d '' file; do
  staged_files+=("$file")
  if [[ -f "$file" ]]; then
    pre_format_hashes+=("$(sha256sum -- "$file" | awk '{print $1}')")
  else
    pre_format_hashes+=("")
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if [[ ${#staged_files[@]} -eq 0 ]]; then
  exit 0
fi

need_meshlink=0
need_reference=0
need_benchmark=0
need_proof=0
need_yaml=0
need_markdown=0
need_hook_validation=0
yaml_files=()
markdown_files=()

for file in "${staged_files[@]}"; do
  case "$file" in
    meshlink/*)
      need_meshlink=1
      ;;
    meshlink-reference/*)
      need_reference=1
      ;;
    meshlink-benchmark/*)
      need_benchmark=1
      ;;
    meshlink-proof/*)
      need_proof=1
      ;;
    .githooks/*|scripts/install-git-hooks.sh|scripts/bootstrap.sh|scripts/check-markdown.sh)
      need_hook_validation=1
      ;;
    build.gradle.kts|settings.gradle.kts|gradle.properties|gradle/*)
      need_meshlink=1
      need_reference=1
      need_benchmark=1
      need_proof=1
      ;;
  esac

  case "$file" in
    *.yml|*.yaml)
      need_yaml=1
      yaml_files+=("$file")
      ;;
    *.md)
      need_markdown=1
      markdown_files+=("$file")
      ;;
  esac
done

# pre-commit is the fast tier: secret scan, hook self-check, YAML lint,
# ktfmt formatting, and Detekt on touched modules only. Full build/test/
# coverage/BCV/docs/invariant checks run in pre-push; CI is authoritative.
# See CONSTITUTION.md Quality Gates.

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "[pre-commit] gitleaks is required to scan staged changes for secrets." >&2
  echo "[pre-commit] Install it with: brew install gitleaks (or see" >&2
  echo "[pre-commit] https://github.com/gitleaks/gitleaks#installing)" >&2
  exit 1
fi
echo "[pre-commit] Scanning staged changes for secrets"
gitleaks protect --staged --redact -v --config .gitleaks.toml

if [[ "$need_hook_validation" -eq 1 ]]; then
  echo "[pre-commit] Validating hook shell scripts"
  bash -n \
    .githooks/pre-commit \
    .githooks/pre-push \
    .githooks/commit-msg \
    scripts/install-git-hooks.sh \
    scripts/bootstrap.sh \
    scripts/check-markdown.sh
fi

if [[ "$need_yaml" -eq 1 ]]; then
  if ! command -v yamllint >/dev/null 2>&1; then
    echo "[pre-commit] yamllint is required for YAML changes." >&2
    echo "[pre-commit] Install it with: brew install yamllint / dnf install yamllint" >&2
    echo "[pre-commit] (or run ./scripts/bootstrap.sh)" >&2
    exit 1
  fi
  echo "[pre-commit] Running YAML lint: ${yaml_files[*]}"
  yamllint "${yaml_files[@]}"
fi

if [[ "$need_markdown" -eq 1 ]]; then
  echo "[pre-commit] Running Markdown lint/link check (offline): ${markdown_files[*]}"
  ./scripts/check-markdown.sh --offline "${markdown_files[@]}"
fi

format_tasks=()
if [[ "$need_meshlink" -eq 1 ]]; then
  format_tasks+=(":meshlink:ktfmtFormat")
fi
if [[ "$need_reference" -eq 1 ]]; then
  format_tasks+=(":meshlink-reference:ktfmtFormat")
fi
if [[ "$need_benchmark" -eq 1 ]]; then
  format_tasks+=(":meshlink-benchmark:ktfmtFormat")
fi
if [[ "$need_proof" -eq 1 ]]; then
  format_tasks+=(":meshlink-proof:ktfmtFormat")
fi

gradle_cmd=(./gradlew --console=plain --configuration-cache --parallel)

if [[ ${#format_tasks[@]} -gt 0 ]]; then
  echo "[pre-commit] Running formatter: ${format_tasks[*]}"
  "${gradle_cmd[@]}" "${format_tasks[@]}"

  formatted_files=()
  for index in "${!staged_files[@]}"; do
    file="${staged_files[$index]}"
    pre_hash="${pre_format_hashes[$index]}"
    if [[ -f "$file" ]]; then
      post_hash="$(sha256sum -- "$file" | awk '{print $1}')"
    else
      post_hash=""
    fi
    if [[ "$pre_hash" != "$post_hash" ]]; then
      formatted_files+=("$file")
    fi
  done

  if [[ ${#formatted_files[@]} -gt 0 ]]; then
    echo "[pre-commit] Formatter changed staged files:"
    for file in "${formatted_files[@]}"; do
      echo "  - $file"
    done
    echo "[pre-commit] Review the formatting changes, stage them, and run git commit again."
    exit 1
  fi
fi

# Fast lint only — Detekt on touched modules. Full build/test/coverage/BCV
# and doc/invariant verification are deferred to pre-push and CI so commits
# stay quick during TDD red-green cycles.
lint_tasks=()
if [[ "$need_meshlink" -eq 1 ]]; then
  lint_tasks+=(":meshlink:detekt")
fi
if [[ "$need_reference" -eq 1 ]]; then
  lint_tasks+=(":meshlink-reference:detekt")
fi
if [[ "$need_benchmark" -eq 1 ]]; then
  lint_tasks+=(":meshlink-benchmark:detekt")
fi
if [[ "$need_proof" -eq 1 ]]; then
  lint_tasks+=(":meshlink-proof:detekt")
fi

if [[ ${#lint_tasks[@]} -gt 0 ]]; then
  echo "[pre-commit] Running Detekt: ${lint_tasks[*]}"
  "${gradle_cmd[@]}" "${lint_tasks[@]}"
fi

# Check test names for invalid characters (e.g., parentheses) that break Kotlin/Native
kotlin_test_files=()
for file in "${staged_files[@]}"; do
  if [[ "$file" == *.kt && "$file" == */commonTest/* ]] || [[ "$file" == *.kt && "$file" == */androidTest/* ]] || [[ "$file" == *.kt && "$file" == */jvmTest/* ]] || [[ "$file" == *.kt && "$file" == */iosTest/* ]] || [[ "$file" == *.kt && "$file" == */test/* ]]; then
    kotlin_test_files+=("$file")
  fi
done

if [[ ${#kotlin_test_files[@]} -gt 0 ]]; then
  echo "[pre-commit] Checking test names for invalid characters..."
  invalid_found=0
  for file in "${kotlin_test_files[@]}"; do
    # Look for backtick-quoted test function names containing parentheses
    # Pattern: fun `name with (parentheses)`()
    if grep -nE "fun\s+\`[^\`]*\([^)]*\)[^\`]*\`" "$file" >/dev/null; then
      echo "[pre-commit] ERROR: Test name with parentheses found in $file:" >&2
      grep -nE "fun\s+\`[^\`]*\([^)]*\)[^\`]*\`" "$file" | sed 's/^/    /' >&2
      echo "[pre-commit] Parentheses in test names are invalid for Kotlin/Native compilation." >&2
      echo "[pre-commit] Replace with words like 'plus', 'minus', 'equals', or rephrase." >&2
      invalid_found=1
    fi
  done
  if [[ $invalid_found -eq 1 ]]; then
    exit 1
  fi
fi